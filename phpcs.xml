<?xml version="1.0"?>
<ruleset name="Syde Users">
    <description>Coding standards for Syde Users plugin</description>

    <!-- What to scan -->
    <file>src/</file>
    <file>tests/</file>
    <file>syde-users.php</file>
    
    <!-- Exclude vendor files -->
    <exclude-pattern>vendor/*</exclude-pattern>

    <!-- Use Syde coding standards -->
    <rule ref="Syde"/>
    
    <!-- Additional WordPress rules -->
    <rule ref="WordPress">
        <!-- Exclude rules that conflict with modern PHP -->
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName.PropertyNotSnakeCase"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName.VariableNotSnakeCase"/>
        <exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName.InterpolatedVariableNotSnakeCase"/>
    </rule>

    <rule ref="Squiz.Commenting.FileComment.MissingPackageTag">
        <severity>0</severity>
    </rule>
    <rule ref="Squiz.Commenting.FileComment.Missing">
        <severity>0</severity>
    </rule>

    <!-- Minimum PHP version -->
    <config name="testVersion" value="8.2-"/>
    
    <!-- Show progress -->
    <arg value="p"/>
    
    <!-- Use colors -->
    <arg name="colors"/>
    
    <!-- Show sniff names -->
    <arg value="s"/>
</ruleset>
