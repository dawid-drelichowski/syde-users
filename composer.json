{
    "name": "drelichowski/syde-users",
    "description": "A WordPress plugin for displaying users from external API in a table format.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "version": "1.0.0",
    "authors": [
        {
            "name": "Dawid Drelichowski",
            "email": "dawid.drelichowski@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "brain/monkey": "^2.6",
        "squizlabs/php_codesniffer": "^3.7",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/php-compatibility": "dev-develop",
        "syde/phpcs": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "SydeUsersPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SydeUsersPlugin\\Tests\\Unit\\": "tests/unit"
        }
    },
    "config": {
        "platform": {
            "php": "8.2"
        },
        "optimize-autoloader": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs",
        "cs-fix": "phpcbf"
    }
}
